# ewaste-pipeline — top-level Snakefile.
# Includes mode-specific rule files. The `all` rule branches per-sample
# based on each sample's kind (protein | nucleotide | fastq).

import os
import re
from pathlib import Path

configfile: os.environ.get("SCYCLE_CONFIG", "config/config.yaml")

SAMPLES = config.get("samples") or {}
# `scycle.py --output DIR` passes results_dir on the command line; otherwise the config decides.
RESULTS = Path(config.get("results_dir") or config["paths"]["results_dir"])

# Per-mode sample name sets — used as wildcard constraints so that
# Mode-A rules only fire on protein/nucleotide samples and Mode-B rules
# only fire on fastq samples. Without this, snakemake's rule-DAG picks
# `apply_rules_protein` for fastq via the ruleorder and prodigal crashes
# on the FASTQ.
PROTEIN_SAMPLES = [
    n for n, m in SAMPLES.items() if m.get("kind") in ("protein", "nucleotide")
]
READ_SAMPLES = [n for n, m in SAMPLES.items() if m.get("kind") == "fastq"]
# Samples with gene coordinates (Prodigal ran) — the only ones that get locus maps.
NUCLEOTIDE_SAMPLES = [n for n, m in SAMPLES.items() if m.get("kind") == "nucleotide"]
NUCLEOTIDE_SAMPLES_RE = "|".join(re.escape(s) for s in NUCLEOTIDE_SAMPLES) or "__NONE__"
PROTEIN_SAMPLES_RE = "|".join(re.escape(s) for s in PROTEIN_SAMPLES) or "__NONE__"
READ_SAMPLES_RE = "|".join(re.escape(s) for s in READ_SAMPLES) or "__NONE__"

# Pathway categories — single source of truth, used by both the per-pathway
# rule's wildcard_constraints (in rules/report.smk) and the rule-all target
# list (cross_sample_figures, defined further below).
PATHWAY_CATEGORIES = [
    "dissimilatory_sulfate_reduction", "sulfur_oxidation",
    "assimilatory_sulfate_reduction", "thiosulfate_polysulfide",
    "organic_sulfur_dmsp", "sulfonate_taurine",
]

include: "rules/common.smk"
include: "rules/protein_mode.smk"
include: "rules/report.smk"


def per_sample_target(name, meta):
    """Final artefacts for one sample: gap_analysis.txt + its S-cycle map, plus
    the locus table / maps when the sample has gene coordinates."""
    rep = RESULTS / name / "report"
    out = [str(rep / "gap_analysis.txt"),
           str(rep / "scycle_map.svg"), str(rep / "scycle_map.png")]
    if meta.get("kind") == "nucleotide":
        out += [str(RESULTS / name / "calls" / "scycle_loci.tsv"),
                str(rep / "loci.svg"), str(rep / "loci.png")]
    return out


def cross_sample_figures():
    """Per-pathway + complex + synergy + S-cycle-map figures in results/figures/.
    Each figure co-renders as SVG (vector) + PNG (300 DPI raster preview)."""
    if not SAMPLES:
        return []
    figdir = RESULTS / "figures"
    bases = (
        [f"pathway_{p}" for p in PATHWAY_CATEGORIES]
        + ["complexes", "synergies", "scycle_maps"]
    )
    return [str(figdir / f"{b}.{ext}") for b in bases for ext in ("svg", "png")]


rule all:
    input:
        # Per-sample reports.
        [per_sample_target(n, m) for n, m in SAMPLES.items()],
        # Cross-sample products (only meaningful with >=1 sample).
        (str(RESULTS / "scycle_matrix.tsv") if SAMPLES else []),
        (str(RESULTS / "scycle_heatmap.svg") if SAMPLES else []),
        (str(RESULTS / "scycle_heatmap.png") if SAMPLES else []),
        # Focused figures (9 SVGs + 9 PNGs in results/figures/).
        cross_sample_figures(),
        # Interactive, self-contained report.
        (str(RESULTS / "scycle_report.html") if SAMPLES else []),
